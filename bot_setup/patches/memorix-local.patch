 from typing import Any, Dict, Optional, Tuple
 
 
+def _memory_slot_ids(ctx: Any) -> list:
+    """她的“记忆”那一格里填的、AstrBot 里确实有的模型 id（kaju_core 不在 / 没填 / 读不了都返回 []）。"""
+    try:
+        import sys
+
+        slots = sys.modules.get("kaju_core.slots")
+        if slots is None:
+            from kaju_core import slots  # type: ignore
+        ids = list(slots.providers("memory"))
+    except Exception:
+        return []
+    return [pid for pid in ids if ctx.get_provider_by_id(pid) is not None]
+
+
+async def _try_memory_slot(ctx: Any, prompt: str, temperature: float, max_tokens: int) -> str:
+    for pid in _memory_slot_ids(ctx):
+        try:
+            resp = await asyncio.wait_for(ctx.llm_generate(
+                chat_provider_id=pid, prompt=prompt, temperature=temperature, max_tokens=max_tokens), timeout=60)
+            text = str(getattr(resp, "completion_text", "") or "")
+            if text and getattr(resp, "role", "") != "err":
+                return text
+        except Exception:
+            continue
+    return ""
+
+
 class AstrBotProviderBridge:
     """AstrBot Context bridge for provider selection and invocation."""
 
