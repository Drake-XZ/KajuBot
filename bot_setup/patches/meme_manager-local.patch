+    def _pick_weighted_meme(self, event: AstrMessageEvent, memes: list[Path]) -> Path:
+        """Pick a meme: primary pack by PRIMARY_PACK_WEIGHT, then one other pack at random.
+
+        Args:
+            event: Event used to resolve the current pack bindings.
+            memes: Candidate images of one category from all bound packs.
+
+        Returns:
+            The chosen image path.
+        """
+        try:
+            context = self._resolve_runtime_pack_context(event=event)
+            primary_root = Path(context.get("pack_dir", "")).resolve()
+            # 图片都在 <包>/memes/<分类>/<文件>，按 <包> 分组（只 resolve 包目录，图片路径不逐个 resolve）
+            by_pack: dict[Path, list[Path]] = {}
+            for m in memes:
+                by_pack.setdefault(Path(m).parents[2], []).append(m)
+            if self.PRIMARY_PACK_WEIGHT is None:
+                return random.choice(random.choice(list(by_pack.values())))
+            primary = next(
+                (by_pack.pop(k) for k in list(by_pack) if k.resolve() == primary_root),
+                [],
+            )
+            if primary and (not by_pack or random.random() < self.PRIMARY_PACK_WEIGHT):
+                return random.choice(primary)
+            if by_pack:
+                return random.choice(random.choice(list(by_pack.values())))
+        except Exception as e:  # noqa: BLE001
+            logger.warning(f"[meme_manager] 主包加权选图失败，改为均匀随机: {e}")
+        return random.choice(memes)
+
