+    def _category_aliases(self) -> dict[str, str]:
+        """Read the alias map (small category -> main category).
+
+        Returns:
+            Alias map without comment keys or self-references; empty when missing or broken.
+        """
+        try:
+            data = json.loads(self.CATEGORY_ALIASES_FILE.read_text(encoding="utf-8"))
+        except FileNotFoundError:
+            return {}
+        except Exception as e:  # noqa: BLE001
+            logger.warning(f"[meme_manager] 读取分类别名失败: {e}")
+            return {}
+        if not isinstance(data, dict):
+            return {}
+        return {
+            str(k): str(v)
+            for k, v in data.items()
+            if not str(k).startswith("_") and isinstance(v, str) and str(k) != v
+        }
+
+    # 本地补丁（佳树）：主包（绑定规则里排第一的包）被抽中的概率。
+    # 主包在该分类有图时，按这个概率只从主包里抽；否则先随机挑一个其他包，再从这个包里抽，
+    # 这样图多的包（比如 ATRI 500 多张）不会把图少的包挤掉。
+    # 插件更新后此补丁会被覆盖，原文件备份在 D:\JiashuBot\_backup。
+    # 2026-11-15 兄长要降回去：None = 不加权，主包和其他包一样按包均分（以前是 0.8）。
+    PRIMARY_PACK_WEIGHT = None
+    # 提示词里要不要附「亲手添加的表情」优先选（main.py _own_pack_category_note），2026-11-15 关掉。
+    OWN_PACK_NOTE = False
